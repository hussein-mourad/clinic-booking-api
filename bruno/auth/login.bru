meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "patient@clinic.com",
    "password": "secret123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar('authToken', res.body.token);
  }
}

docs {
  Logs in and returns a JWT. Auto-sets the `authToken` collection variable
  from the response so subsequent authenticated requests work.
}

meta {
  name: My appointments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/doctors/me/appointments?from=2026-08-10&to=2026-08-11
  body: none
  auth: bearer
}

params:query {
  from: 2026-08-10
  to: 2026-08-11
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Lists the current doctor booked appointments, including the patient name (doctor role only).
  Both query params are optional; from/to (YYYY-MM-DD) filter by appointment start date.
}

meta {
  name: Monthly analytics
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/doctors/me/analytics?month=2026-08
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

query {
  month: 2026-08
}

docs {
  Monthly analytics for the current doctor, aggregated entirely in SQL (doctor role).
  Returns total_appointments, cancellation_rate, peak_booking_hours and avg_utilization.
}

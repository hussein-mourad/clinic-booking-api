meta {
  name: My appointments
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/appointments/me?status=completed
  body: none
  auth: bearer
}

params:query {
  status: completed
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Lists the current patient's appointments (patient role only).
  Returns all statuses by default; use ?status=scheduled|cancelled|completed
  to filter to a single status.
}
